# Vertex AI configuration. Replace these values with your Google Cloud setup.
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_LOCATION=us-west1
VERTEX_AI_AGENT_RESOURCE=projects/YOUR_PROJECT_NUMBER/locations/us-west1/reasoningEngines/YOUR_REASONING_ENGINE_ID

# Optional for local development; required for durable deployed sessions.
REDIS_URL=redis://127.0.0.1:6379/0

# Allow the local Vite development server to call this API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
