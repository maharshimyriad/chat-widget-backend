# Vertex AI configuration. Replace these values with your Google Cloud setup.
GOOGLE_CLOUD_PROJECT=YOUR_GOOGLE_CLOUD_PROJECT
GOOGLE_CLOUD_LOCATION=us-west1
VERTEX_AI_AGENT_RESOURCE=projects/YOUR_PROJECT_NUMBER/locations/us-west1/reasoningEngines/YOUR_REASONING_ENGINE_ID

# Optional live-reloaded allowlist file. When set, it takes precedence over
# CORS_ALLOWED_ORIGINS. Copy allowed-origins.example.txt to a writable server
# path, then edit that file to add/remove origins without restarting the API.
# CORS_ALLOWED_ORIGINS_FILE=/etc/chat-widget/allowed-origins.txt

# Static alternative: * accepts any origin; a comma-separated list restricts it.
# If both settings are unset, browser-origin requests are rejected.
# CORS_ALLOWED_ORIGINS=https://site-one.example,https://site-two.example

